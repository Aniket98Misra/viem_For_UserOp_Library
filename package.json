{
  "name": "viem-userop",
  "version": "0.1.0",
  "description": "A provider-agnostic viem client extension for building, sending, and debugging ERC-4337 UserOperations across EntryPoint v0.6 and v0.7.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsup": "^8.0.0",
    "vitest": "^5.0.0",
    "viem": "^2.21.0"
  },
  "license": "MIT"
}
